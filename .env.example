# Which AI backend to use: "anthropic" (Claude) or "openai-compatible" (open-source models via Groq, OpenRouter, Together, Ollama, LM Studio...)
AI_PROVIDER=anthropic

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = deeper reasoning, slower, more tokens)
ANTHROPIC_EFFORT=high

# --- Open-source models (OpenAI-compatible API) ---
# Groq:       https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
# Ollama:     http://localhost:11434/v1   (no key needed)
OSS_BASE_URL=https://api.groq.com/openai/v1
OSS_API_KEY=
# Must be a vision-capable model if you upload images/videos
OSS_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Set to false for text-only models (images are then described as unavailable to the model)
OSS_SUPPORTS_VISION=true

# --- Optional live trend sources ---
# Free key from Google Cloud console (YouTube Data API v3). Adds YouTube "most popular" titles + tags.
YOUTUBE_API_KEY=

PORT=3000
# Requests per minute per IP to the AI endpoints
RATE_LIMIT_PER_MIN=20
