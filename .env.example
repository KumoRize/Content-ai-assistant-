# ===== 100% free setup =====
# 1. Create a free Groq key at https://console.groq.com/keys (no credit card)
# 2. Paste it below. That's it: Llama 4 Scout (vision) + Whisper lyrics transcription.
OSS_API_KEY=

# Advanced: any OpenAI-compatible endpoint works (OpenRouter, Together, or Ollama/LM Studio on your own PC for free)
OSS_BASE_URL=https://api.groq.com/openai/v1
OSS_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OSS_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Set to false for text-only models
OSS_SUPPORTS_VISION=true
# Groq's free tier accepts up to 5 images per request; extra video frames are sampled evenly
OSS_MAX_IMAGES=5

# Which engine "Auto" tries first: "openai-compatible" (free, default) or "anthropic"
AI_PROVIDER=openai-compatible

# ===== Optional paid extra: Claude (adds live web search) =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high

# --- Optional live trend sources ---
# Free key from Google Cloud console (YouTube Data API v3). Adds YouTube "most popular" titles + tags.
YOUTUBE_API_KEY=

PORT=3000
# Requests per minute per IP to the AI endpoints
RATE_LIMIT_PER_MIN=20
